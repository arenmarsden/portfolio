---
import Layout from '../layouts/Layout.astro'

const experiences = [
	{
		role: 'Backend & Infrastructure Consultant',
		company: 'Freelance / Contract',
		duration: '2022 — Present',
		description:
			'Working with startups and scale-ups to build secure, scalable, production-ready systems in Go, AWS, and Kubernetes.'
	},
	{
		role: 'Software Engineer',
		company: 'Science & Technology Facilities Council',
		duration: '2024 — 2025',
		description:
			'Supported the design and development of a high-performance computing product designed to support insitutions in microelectronics research'
	},
	{
		role: 'Assistant Web Developer',
		company: 'Manchester Business Hub',
		duration: '2021 - 2022',
		description:
			'Supported the efforts to MBH to enhance their B2B Platform and improve search engine optimisation for small businesses'
	}
]

const skills = [
	'Go',
	'AWS',
	'Terraform',
	'SQL',
	'Pulumi',
	'Tailwind',
	'Kubernetes',
	'Java',
	'Typescript',
	'C',
	'C++',
	'C#',
	'Python',
	'Azure',
	'Full-Stack Web Development',
	'Rapid prototyping'
]
---

<Layout title="Background">
	<main class="bg-gray-800 px-4 py-10 text-white md:py-16">
		<div class="mx-auto max-w-4xl space-y-12">
			<section>
				<h1 class="mb-4 text-4xl font-bold text-blue-400">Background</h1>
				<p class="text-lg">
					I’m a backend & infrastructure engineer with a focus on helping technical teams
					ship fast, secure, and scalable systems — from day one. Throughout my
					experience, I've worked with many diverse teams across the UK, ranging from
					small teams within MBH at a local level, to a larger team at the STFC working on
					a global level.
				</p>
			</section>

			<section>
				<h2 class="mb-4 text-2xl font-semibold text-blue-300">Experience</h2>
				<ul class="space-y-6">
					{
						experiences.map((exp) => (
							<li class="border-l-4 border-blue-500 pl-4">
								<h3 class="text-xl font-bold">
									{exp.role} — <span class="text-blue-200">{exp.company}</span>
								</h3>
								<p class="text-sm italic text-gray-300">{exp.duration}</p>
								<p class="mt-2 text-gray-200">{exp.description}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2 class="mb-4 text-2xl font-semibold text-blue-300">Core Skills</h2>
				<div class="flex flex-wrap gap-2">
					{
						skills.map((skill) => (
							<span class="rounded-full bg-blue-600 px-3 py-1 text-sm">{skill}</span>
						))
					}
				</div>
			</section>

			<section>
				<p class="text-center text-lg">
					Extra relevant experience can be requested through enquiry.
				</p>
			</section>

			<!-- Social Profiles -->
			<section class="mt-16 text-center">
				<h2 class="mb-4 text-2xl font-semibold text-blue-300">Connect with me</h2>
				<div class="flex justify-center space-x-8">
					<a
						href="https://github.com/arenmarsden"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub"
						class="text-gray-300 transition hover:text-white"
					>
						<svg
							class="h-8 w-8 fill-current"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
						>
							<path
								d="M12 0C5.37 0 0 5.37 0 12a12 12 0 008.21 11.43c.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.34-1.77-1.34-1.77-1.09-.75.08-.74.08-.74 1.21.09 1.84 1.25 1.84 1.25 1.07 1.83 2.8 1.3 3.49.99.11-.77.42-1.3.76-1.6-2.66-.3-5.46-1.33-5.46-5.92 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.52 11.52 0 016 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.6-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22 0 1.6-.02 2.89-.02 3.28 0 .32.21.7.82.58A12 12 0 0024 12c0-6.63-5.37-12-12-12z"
							></path>
						</svg>
					</a>

					<a
						href="https://linkedin.com/in/arenmarsden"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
						class="text-gray-300 transition hover:text-white"
					>
						<svg
							class="h-8 w-8 fill-current"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
						>
							<path
								d="M20.447 20.452h-3.554v-5.569c0-1.328-.024-3.036-1.849-3.036-1.851 0-2.134 1.445-2.134 2.94v5.665H9.356V9h3.414v1.561h.048c.476-.9 1.637-1.849 3.368-1.849 3.602 0 4.268 2.37 4.268 5.451v6.289zM5.337 7.433c-1.144 0-2.068-.926-2.068-2.067 0-1.142.924-2.068 2.068-2.068 1.142 0 2.066.926 2.066 2.068 0 1.141-.924 2.067-2.066 2.067zM6.768 20.452H3.907V9h2.86v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.727v20.545C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.273V1.727C24 .774 23.2 0 22.225 0z"
							></path>
						</svg>
					</a>
				</div>
			</section>
		</div>
	</main>
</Layout>
