---
import Layout from '../layouts/Layout.astro'
---

<Layout title="home">
	<main class="flex flex-col items-center justify-center bg-gray-800 md:flex-row md:min-h-screen">
		<div class="mx-auto flex w-full flex-col items-center justify-center py-8 md:flex-row">
			<!-- Image Section -->
			<div class="w-full md:w-1/3">
				<img src="/images/me.png" alt="Aren's Image" class="w-full rounded-full" />
			</div>

			<!-- Text & CTA Section -->
			<div class="w-full p-4 text-center md:w-1/2">
				<h1 class="text-4xl font-bold text-white">
					Hey, I'm <span class="text-blue-400">Aren</span>
				</h1>
				<p class="mt-4 text-white text-xl">
					I help startups and technical teams build production-ready backend systems and infrastructure<br/> — fast, secure, and scalable from day one.
				</p>
				<div class="mt-6">
					<a
						href="https://outlook.office.com/bookwithme/user/bc967876fe81461d833a8372465e876e@arenmarsden.com/meetingtype/8CdO1oVjx0yqkdRpFPV_UQ2?anonymous&ismsaljsauthenabled&ep=mlink"
						class="inline-block rounded-lg bg-blue-400 px-6 py-3 text-white hover:bg-blue-600 transition"
					>
						Book a Free Consultation
					</a>
				</div>
			</div>
		</div>
	</main>
</Layout>
