---
import Layout from '../layouts/Layout.astro'
---

<Layout title="home">
	<main class="bg-gray-800 text-white">
		<!-- HERO / CTA SECTION -->
		<section
			class="flex flex-col items-center justify-center bg-gray-800"
			style="height: calc(100vh - 4rem);"
		>
			<div class="mx-auto flex w-full flex-col items-center justify-center py-8 md:flex-row">
				<div class="w-full md:w-1/3">
					<img
						src="/images/me.png"
						alt="Aren's Image"
						class="mx-auto h-auto w-72 rounded-full sm:w-80 md:w-full"
					/>
				</div>
				<div class="w-full p-4 text-center md:w-1/2">
					<h1 class="text-4xl font-bold">
						Fast, secure, cost-efficient infrastructure on dedicated servers
					</h1>
					<p class="mt-4 text-xl">
						I manage bare-metal servers hosted in top-tier data centres like Hetzner and
						OVH — full control, predictable performance, and lower costs than cloud
						platforms.
					</p>
					<div class="mt-6">
						<a
							href="#problem"
							class="inline-block rounded-lg bg-blue-400 px-6 py-3 text-white transition hover:bg-blue-600"
						>
							Learn More ↓
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- PROBLEM SECTION -->
		<section
			id="problem"
			class="flex items-center justify-center bg-gradient-to-b from-gray-800 to-slate-900"
			style="min-height: 100vh;"
		>
			<div class="mx-auto max-w-3xl py-16 text-center">
				<h2 class="mb-6 text-3xl font-bold">
					Most startups overpay for cloud and still get downtime
				</h2>
				<p class="mb-8 text-lg text-gray-300">
					Your infrastructure should work for you — not against you. Without proper
					management, teams often face:
				</p>
				<ul class="mx-auto grid max-w-xl gap-4 text-left md:grid-cols-2">
					<li class="flex items-start">
						<span class="mr-3 font-bold text-blue-400">•</span>
						Unpatched systems causing security vulnerabilities
					</li>
					<li class="flex items-start">
						<span class="mr-3 font-bold text-blue-400">•</span>
						Broken CI/CD pipelines slowing down development
					</li>
					<li class="flex items-start">
						<span class="mr-3 font-bold text-blue-400">•</span>
						Unexpected cloud bills eating into your budget
					</li>
					<li class="flex items-start">
						<span class="mr-3 font-bold text-blue-400">•</span>
						Downtime and outages disrupting users and revenue
					</li>
				</ul>
				<a
					href="#services"
					class="mt-8 inline-block rounded-lg bg-blue-400 px-6 py-3 text-white transition hover:bg-blue-600"
				>
					See How I Fix These Problems
				</a>
			</div>
		</section>

		<svg
			class="h-24 w-full text-slate-900"
			fill="currentColor"
			viewBox="0 0 1440 320"
			preserveAspectRatio="none"
		>
			<path fill-opacity="1" d="M0,160L1440,0L1440,320L0,320Z"></path>
		</svg>

		<!-- SERVICES SECTION -->
		<section
			id="services"
			class="flex items-center justify-center bg-gradient-to-b from-gray-900 to-slate-800"
			style="min-height: 100vh;"
		>
			<div class="mx-auto max-w-4xl py-16 text-center">
				<h2 class="mb-6 text-3xl font-bold text-white">Services & Pricing</h2>
				<p class="mb-8 text-lg text-gray-300">
					Choose the plan that best fits your infrastructure needs.
				</p>
				<div class="grid gap-8 md:grid-cols-3">
					<!-- One-Time Setup / Quick Launch -->
					<div
						class="flex h-full flex-col rounded-2xl border border-blue-400 p-6 shadow-lg transition hover:shadow-blue-400/40"
					>
						<h3 class="mb-2 text-xl font-semibold text-white">Quick Launch</h3>
						<p class="mb-4 text-gray-300">
							Get your servers up and running in record time. Perfect for teams who
							want to go live fast without ongoing management.
						</p>
						<hr class="mb-4 border-gray-700" />
						<ul class="mb-6 list-inside list-disc space-y-1 text-gray-300">
							<li>Bare-metal server provisioning</li>
							<li>Initial monitoring setup</li>
							<li>Basic security hardening & patches</li>
							<li>Backup setup</li>
						</ul>
						<div class="mt-auto">
							<p class="mb-4 text-2xl font-bold text-blue-400">£300 one-time</p>
							<a
								href="/contact"
								class="inline-block rounded bg-blue-400 px-4 py-2 text-white hover:bg-blue-600"
								>Get Started</a
							>
						</div>
					</div>

					<!-- Starter / Basic Management -->
					<div
						class="flex h-full flex-col rounded-2xl border border-blue-400 p-6 shadow-lg transition hover:shadow-blue-400/40"
					>
						<h3 class="mb-2 text-xl font-semibold text-white">Starter</h3>
						<p class="mb-4 text-gray-300">
							Perfect for small startups needing stable, secure infrastructure.
						</p>
						<hr class="mb-4 border-gray-700" />
						<ul class="mb-6 list-inside list-disc space-y-1 text-gray-300">
							<li>Bare-metal server setup</li>
							<li>Monitoring</li>
							<li>Patch management</li>
							<li>Backups</li>
						</ul>
						<div class="mt-auto">
							<p class="mb-4 text-2xl font-bold text-blue-400">£500/mo</p>
							<a
								href="/contact"
								class="inline-block rounded bg-blue-400 px-4 py-2 text-white hover:bg-blue-600"
								>Get Started</a
							>
						</div>
					</div>

					<!-- Growth / Full Management -->
					<div
						class="flex h-full flex-col rounded-2xl border border-blue-400 p-6 shadow-lg transition hover:shadow-blue-400/40"
					>
						<h3 class="mb-2 text-xl font-semibold text-white">Growth</h3>
						<p class="mb-4 text-gray-300">
							Ideal for growing teams needing reliability and speed.
						</p>
						<hr class="mb-4 border-gray-700" />
						<ul class="mb-6 list-inside list-disc space-y-1 text-gray-300">
							<li>Everything in Starter</li>
							<li>CI/CD maintenance</li>
							<li>Cost optimization</li>
							<li>Scaling support</li>
						</ul>
						<div class="mt-auto">
							<p class="mb-4 text-2xl font-bold text-blue-400">£1,000/mo</p>
							<a
								href="/contact"
								class="inline-block rounded bg-blue-400 px-4 py-2 text-white hover:bg-blue-600"
								>Get Started</a
							>
						</div>
					</div>

					<!-- Scale / CTO-Level -->
					<div
						class="flex h-full flex-col rounded-2xl border border-blue-400 p-6 shadow-lg transition hover:shadow-blue-400/40"
					>
						<h3 class="mb-2 text-xl font-semibold text-white">Scale</h3>
						<p class="mb-4 text-gray-300">
							Hands-on support and CTO-level guidance for complex infrastructure
							challenges.
						</p>
						<hr class="mb-4 border-gray-700" />
						<ul class="mb-6 list-inside list-disc space-y-1 text-gray-300">
							<li>Everything in Growth</li>
							<li>Architecture planning</li>
							<li>On-demand CTO guidance</li>
						</ul>
						<div class="mt-auto">
							<p class="mb-4 text-2xl font-bold text-blue-400">£2,000+/mo</p>
							<a
								href="/contact"
								class="inline-block rounded bg-blue-400 px-4 py-2 text-white hover:bg-blue-600"
								>Contact Me</a
							>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
