---
import Navigation from '../components/vue/navigation.vue'

interface Props {
	title: string
}

const { title } = Astro.props
let activePage = `${Astro.url.pathname}`
---

<!doctype html>
<html lang="en" class="overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} &bullet; mrsn.dev</title>
		<style>
			html, body {
				overflow-x: hidden;
				padding: 0;
				margin: 0;
				height: 100%;
			}
			* {
				padding: 0 !important;
				margin: 0 !important;
			}
			</style>
	</head>
	<body class="overflow-x-hidden bg-gray-800 min-h-screen">
		<Navigation client:load activePage={activePage} />
		<slot />
	</body>
</html>
